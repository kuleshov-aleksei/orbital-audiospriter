{
  "name": "orbital-audiospriter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:ffmpeg": "node scripts/copy-ffmpeg-core.mjs",
    "predev": "node scripts/copy-ffmpeg-core.mjs",
    "prebuild": "node scripts/copy-ffmpeg-core.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint --config eslint.config.js src/ --fix",
    "lint:check": "eslint --config eslint.config.js src/",
    "prettier": "prettier . --write"
  },
  "dependencies": {
    "@ffmpeg/core-st": "^0.11.1",
    "@ffmpeg/ffmpeg": "^0.12.15",
